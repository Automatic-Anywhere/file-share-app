<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- MÀN HÌNH CHỌN CHẾ ĐỘ BAN ĐẦU -->
    <LinearLayout
        android:id="@+id/selectionLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        android:background="#667eea">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁 File Share App"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="50dp"/>

        <Button
            android:id="@+id/btnHost"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🟢 Mở Server (Host)"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#ffffff"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnClient"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🔵 Tham gia Server (Client)"
            android:textSize="18sp"
            android:backgroundTint="#2196F3"
            android:textColor="#ffffff"/>
    </LinearLayout>

    <!-- MÀN HÌNH THAM GIA SERVER (CLIENT) -->
    <LinearLayout
        android:id="@+id/clientLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#f0f2f5"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tham gia Server"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="20dp"/>

        <!-- Nhập IP thủ công -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etIpAddress"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="VD: 192.168.1.15:8000"
                android:padding="10dp"
                android:background="@android:drawable/edit_text"
                android:inputType="textUri"
                android:layout_marginRight="10dp"/>

            <Button
                android:id="@+id/btnConnectIp"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Kết nối"
                android:backgroundTint="#2196F3"
                android:textColor="#ffffff"/>
        </LinearLayout>

        <!-- Nút Quét QR -->
        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📷 Quét mã QR của Server"
            android:backgroundTint="#ff9800"
            android:textColor="#ffffff"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lịch sử kết nối"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#666"
            android:layout_marginBottom="10dp"/>

        <!-- Danh sách lịch sử -->
        <ListView
            android:id="@+id/lvHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"/>

        <!-- Nút quay lại màn hình chọn -->
        <Button
            android:id="@+id/btnBackToSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⬅️ Quay lại"
            android:backgroundTint="#9e9e9e"
            android:textColor="#ffffff"
            android:layout_marginTop="20dp"/>
    </LinearLayout>

    <!-- MÀN HÌNH WEBVIEW -->
    <LinearLayout
        android:id="@+id/webLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#667eea"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:elevation="4dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬅️ Quay lại"
                android:textColor="#ffffff"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:textSize="16sp"/>
                
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="File Share"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>
            
            <View android:layout_width="80dp" android:layout_height="1dp"/>
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</RelativeLayout>
